# Keyhold settings. Copy to .env (git-ignored), fill in, and start the app with
#   uv run --env-file .env python -m web
# Never commit real values. Keyhold does not print or log the secrets set here.
# Left empty, a setting takes its default. With no PayPal credentials the app runs offline.

# --- PayPal (sandbox only; Keyhold refuses any other environment) ---------------------------
# REST app credentials from the PayPal developer dashboard, sandbox tab.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Id of the webhook on that sandbox app, used by verify-webhook-signature. Point the webhook at
# https://<your host>/webhooks/paypal. Without it no delivery verifies and the second tick never
# shows (the pages and /healthz say so).
PAYPAL_WEBHOOK_ID=

# --- Claude (only when KEYHOLD_WORLD=vm) ------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional: an Anthropic-compatible endpoint that serves the same Claude models. Leave empty for
# the Claude API itself (an empty value would break the SDK, so keep the line commented out).
# ANTHROPIC_BASE_URL=
# claude-opus-5-5 (default) or claude-haiku-5-5.
KEYHOLD_MODEL=
# Optional: a header name that carries one id per rescue, for gateways that route by conversation.
KEYHOLD_MODEL_SESSION_HEADER=
# Effort for the free look and the agent: low, medium, high, xhigh or max. Default: medium.
KEYHOLD_MODEL_EFFORT=

# --- Mode and world ---------------------------------------------------------------------------
# live (PayPal sandbox) or offline (FakePayPal in memory).
# Default: live when both PayPal credentials are set, offline otherwise.
KEYHOLD_MODE=
# vm (a fresh local test VM per run, and Claude) or simulated (a scripted console and a recorded
# agent, no model call). Default: vm in live mode, simulated offline.
KEYHOLD_WORLD=
# 1: compressed, labelled probe and warranty timing for demos (two passes at least 10 s apart;
# a warranty check every minute for 24 minutes). 0: two passes at least 30 s apart; a warranty
# check every hour for 24 hours. Default: 1.
KEYHOLD_JUDGE_MODE=1

# --- The /try page ----------------------------------------------------------------------------
# Passcode for /try. Live mode does not start runs until it is set; offline, empty means open.
KEYHOLD_TRY_PASSCODE=
# Model spend allowed per rolling 24 hours and per run, in US dollars. Defaults: 10.00 and 3.00.
KEYHOLD_MODEL_SPEND_CAP_USD=10.00
KEYHOLD_RUN_BUDGET_USD=3.00
# Runs one address may start per hour. Default: 4.
KEYHOLD_TRY_RUNS_PER_HOUR=
# Agent turn limit, agent time limit in seconds, and seconds to check out before the server is
# released. Defaults: 30, 1200 and 900.
KEYHOLD_MAX_TURNS=
KEYHOLD_RESCUE_TIMEOUT_S=
KEYHOLD_QUOTE_TTL_S=
# Override the warranty: number of checks and seconds between them. Default: from the mode above.
KEYHOLD_WARRANTY_CHECKS=
KEYHOLD_WARRANTY_INTERVAL_S=

# --- Web server -------------------------------------------------------------------------------
# Listen address and port. Defaults: the loopback address and 8000.
KEYHOLD_HOST=
KEYHOLD_PORT=
# Signs the session cookie, at least 16 characters. Default: random per process.
KEYHOLD_SECRET_KEY=
# 1 only behind one HTTPS proxy that appends the peer address to X-Forwarded-For (needed to
# receive PayPal webhooks). Keyhold uses the last entry, the one that proxy added.
KEYHOLD_TRUST_PROXY=

# --- Storage ----------------------------------------------------------------------------------
# Data folder (ledger, offline PayPal state, thumbnails). Default: var
KEYHOLD_DATA_DIR=
# SQLite ledger. Default: <data folder>/keyhold.db
KEYHOLD_DB=
# VM images and runs (see tools/vm/README.md). Default: var/vm in the project checkout.
KEYHOLD_VM_HOME=
# QEMU runner image for the test VMs. Default: keyhold-qemu-runner:3, which tools/vm/vm.py runner
# builds for this host's architecture. The guests have the image's architecture (arm64 or amd64).
KEYHOLD_RUNNER_IMAGE=
# known_hosts files of the owner probe, one per rescue. Default: <data folder>/probe
KEYHOLD_PROBE_STATE_DIR=
# Owner probe private key (mode 600) for code that builds SubprocessSsh.from_env. The web app's
# test VMs use the key that tools/vm/vm.py golden creates in the VM home instead.
KEYHOLD_PROBE_KEY=
